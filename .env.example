# ============================================================
#  JAVA RADIO · 140.1 · configuración
#  Copia este archivo como .env y rellena lo que necesites.
#  Autor: Lott Campuzano
#  https://github.com/Lott-Campuzano
#  https://lott-campuzano.vercel.app/
# ============================================================

# --- Servidor -------------------------------------------------
PORT=4321
HOST=127.0.0.1
# Pon HOST=0.0.0.0 si quieres escucharla desde el móvil en tu red local.
# En producción (Render, Fly, Railway…) el host lo suele imponer la plataforma.

# Firma las URLs del audio y las sesiones. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la dejas vacía se genera una nueva en cada arranque (las sesiones
# abiertas dejan de valer al reiniciar).
SESSION_SECRET=

# ============================================================
#  GOOGLE DRIVE
# ============================================================
# Carpeta con los audios. Acepta el enlace completo o solo el ID:
#   https://drive.google.com/drive/folders/1AbCdEfGh...
DRIVE_FOLDER_ID=

# --- Opción 0 · carpeta pública SIN API key -------------------
# Si la carpeta está compartida como «Cualquiera con el enlace»,
# basta con DRIVE_FOLDER_ID. El servidor la lista con la vista
# pública de Drive y sirve el audio con Range. Es el modo más
# rápido, pero depende del HTML público de Drive.

# --- Opción A · carpeta pública + API key ---------------------
# Google Cloud → APIs y servicios → Credenciales → Crear clave de API.
# Restríngela a "Google Drive API".
GOOGLE_API_KEY=

# --- Opción B · cuenta de servicio (carpeta privada) ----------
# Comparte la carpeta con el email de la cuenta de servicio (lector).
# Puede ser una ruta a un .json o el JSON completo en una línea.
GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ============================================================
#  MODO LOCAL (sin Drive)
# ============================================================
# auto  = Drive si está configurado; si no, carpeta local.
# drive = solo Drive (falla si no hay carpeta configurada).
# local = solo la carpeta musica/.
SOURCE=auto

# Carpeta local de audio (por defecto ./musica).
# MUSIC_DIR=/ruta/a/mi/musica

# Nombre que aparece como "álbum" en las canciones sueltas.
# RADIO_ALBUM=Selección de Java Radio

# Cookies Secure (actívalo si sirves la radio por HTTPS).
SECURE_COOKIES=0
